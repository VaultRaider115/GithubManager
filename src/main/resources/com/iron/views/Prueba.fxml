<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane fx:id="root"
            prefWidth="1320.0" prefHeight="860.0" minWidth="1120.0" minHeight="720.0"
            styleClass="app-root" stylesheets="@../css/style.css"
            xmlns="http://javafx.com/javafx/27.0.1.1" xmlns:fx="http://javafx.com/fxml/1">

  <!-- ============================== SIDEBAR ============================== -->
  <left>
    <fx:include source="Sidebar.fxml"/>
  </left>

  <center>
    <VBox styleClass="main-shell">

      <!-- ============================== GLOBAL TOP BAR ============================== -->
      <fx:include source="Topbar.fxml"/>

      <!-- ============================== SCREEN SWITCHER ============================== -->
      <TabPane fx:id="tabs" styleClass="screen-tabs" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
        <tabs>
          <Tab text="Overview">
            <graphic>
              <SVGPath content="M1.5 1.5h5v5h-5zM9.5 1.5h5v5h-5zM1.5 9.5h5v5h-5zM9.5 9.5h5v5h-5z"
                       styleClass="tab-icon"/>
            </graphic>
            <content>
              <fx:include source="Overview.fxml"/>
            </content>
          </Tab>

          <Tab text="Repositories">
            <graphic>
              <SVGPath content="M2 1.5h4.2c1 0 1.8.8 1.8 1.8v10.2c-.4-.8-1.2-1.2-2.2-1.2H2V1.5zM14 1.5H9.8c-1 0-1.8.8-1.8 1.8v10.2c.4-.8 1.2-1.2 2.2-1.2H14V1.5z"
                       styleClass="tab-icon"/>
            </graphic>
            <content>
              <fx:include source="Repositories.fxml"/>
            </content>
          </Tab>

          <Tab text="Activity">
            <graphic>
              <SVGPath content="M2 9h3v5H2zM6.5 5h3v9h-3zM11 1.5h3v12.5h-3z"
                       styleClass="tab-icon"/>
            </graphic>
            <content>
              <fx:include source="Activity.fxml"/>
            </content>
          </Tab>

          <Tab text="Security">
            <graphic>
              <SVGPath content="M8 1.2l5.2 2.1v3.9c0 3.2-2.1 5.8-5.2 7.1-3.1-1.3-5.2-3.9-5.2-7.1V3.3L8 1.2z"
                       styleClass="tab-icon"/>
            </graphic>
            <content>
              <fx:include source="Security.fxml"/>
            </content>
          </Tab>

          <Tab text="Settings">
            <graphic>
              <SVGPath content="M1.5 3h13v2h-13zM4 2h2v4H4zM1.5 7h13v2h-13zM10 6h2v4h-2zM1.5 11h13v2h-13zM7 10h2v4H7z"
                       styleClass="tab-icon"/>
            </graphic>
            <content>
              <fx:include source="Settings.fxml"/>
            </content>
          </Tab>
        </tabs>
      </TabPane>

    </VBox>
  </center>
</BorderPane>
