<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>

<HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="topbar"
      xmlns="http://javafx.com/javafx/27.0.1.1" xmlns:fx="http://javafx.com/fxml/1">

  <VBox spacing="1.0">
    <HBox alignment="CENTER_LEFT" spacing="5.0">
      <Label text="github.com" styleClass="topbar-eyebrow"/>
      <Label text="/" styleClass="topbar-separator"/>
      <Label id="topbarCrumb" text="github" styleClass="topbar-crumb"/>
    </HBox>
    <Label text="Account workspace" styleClass="topbar-title"/>
  </VBox>

  <Region HBox.hgrow="ALWAYS" minWidth="10.0"/>

  <TextField promptText="Search repositories, people, issues…" prefWidth="280.0" minWidth="170.0"
             styleClass="search-field"/>
  <Label text="Ctrl K" styleClass="kbd"/>

  <StackPane prefWidth="38.0" prefHeight="38.0" minWidth="38.0" maxWidth="38.0"
             minHeight="38.0" maxHeight="38.0" styleClass="icon-button">
    <SVGPath content="M8 1.5C5.6 1.5 4 3.4 4 6v3L2.5 11.5h11L12 9V6c0-2.6-1.6-4.5-4-4.5zM6.4 13c.3 1.2.8 1.7 1.6 1.7s1.3-.5 1.6-1.7z"
             scaleX="1.1" scaleY="1.1" styleClass="top-icon"/>
    <Circle radius="3.0" fill="#f85149" stroke="#0d1117" strokeWidth="2.0"
            StackPane.alignment="TOP_RIGHT" translateX="-2.0" translateY="2.0"/>
  </StackPane>

  <Button text="New repository" mnemonicParsing="false" styleClass="button-primary">
    <graphic>
      <SVGPath content="M7 1h2v6h6v2H9v6H7V9H1V7h6z" scaleX="0.8" scaleY="0.8"
               styleClass="button-icon-fill"/>
    </graphic>
  </Button>

  <StackPane prefWidth="30.0" prefHeight="30.0" minWidth="30.0" maxWidth="30.0"
             minHeight="30.0" maxHeight="30.0" styleClass="avatar">
    <Label id="topbarInitials" text="ID" styleClass="avatar-initials, avatar-initials-xs"/>
  </StackPane>

</HBox>
