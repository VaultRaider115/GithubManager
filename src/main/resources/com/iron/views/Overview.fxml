<ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
            styleClass="screen-scroll" stylesheets="@../css/overview.css"
            xmlns="http://javafx.com/javafx/27.0.1.1" xmlns:fx="http://javafx.com/fxml/1">
  <content>
    <VBox spacing="20.0" styleClass="screen">

      <!-- ============================== SCREEN HEADER ============================== -->
      <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="screen-header">
        <VBox spacing="2.0">
          <Label text="OVERVIEW" styleClass="screen-eyebrow"/>
          <Label text="Your GitHub at a glance" styleClass="screen-title"/>
          <Label text="Profile, repositories and activity in one place." styleClass="screen-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Label id="overviewStatus" text="Loading GitHub…" styleClass="screen-meta"/>
        <Button id="overviewRefresh" text="Refresh" mnemonicParsing="false" styleClass="button-secondary"/>
      </HBox>

      <!-- ============================== PROFILE HERO ============================== -->
      <VBox styleClass="hero-card">
        <Region prefHeight="70.0" maxWidth="Infinity" styleClass="hero-cover"/>
        <HBox alignment="TOP_LEFT" spacing="18.0" styleClass="hero-body">
          <StackPane prefWidth="68.0" prefHeight="68.0" minWidth="68.0" maxWidth="68.0"
                     minHeight="68.0" maxHeight="68.0" styleClass="avatar, avatar-lg">
            <Label id="heroInitials" text="ID" styleClass="avatar-initials, avatar-initials-lg"/>
            <Circle radius="6.0" fill="#3fb950" stroke="#161b22" strokeWidth="3.0"
                    StackPane.alignment="BOTTOM_RIGHT"/>
          </StackPane>
          <VBox spacing="5.0" HBox.hgrow="ALWAYS" minWidth="0.0">
            <HBox alignment="CENTER_LEFT" spacing="8.0">
              <Label id="heroName" text="Loading…" styleClass="hero-name"/>
              <Label id="heroPlan" text="PRO" styleClass="badge-pro"/>
              <Label id="heroAvailable" text="Available" styleClass="badge-success"/>
            </HBox>
            <Label id="heroHandle" text="\@github" styleClass="hero-handle"/>
            <Label id="heroBio" text="Loading profile…" wrapText="true" styleClass="hero-bio"/>
            <HBox alignment="CENTER_LEFT" spacing="8.0">
              <Label id="heroLocation" text="Location" styleClass="meta"/>
              <Label text="·" styleClass="meta-dot"/>
              <Label id="heroBlog" text="website" styleClass="meta, meta-link"/>
              <Label text="·" styleClass="meta-dot"/>
              <Label id="heroJoined" text="Joined" styleClass="meta"/>
            </HBox>
          </VBox>
          <HBox alignment="TOP_RIGHT" spacing="8.0" minWidth="-Infinity">
            <Button text="Edit profile" mnemonicParsing="false" minWidth="-Infinity" styleClass="button-secondary"/>
            <Button text="···" mnemonicParsing="false" minWidth="-Infinity" styleClass="button-icon"/>
          </HBox>
        </HBox>
        <HBox alignment="CENTER_LEFT" styleClass="hero-stats">
          <VBox alignment="CENTER" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="stat-block">
            <Label id="statRepos" text="0" styleClass="stat-number"/>
            <Label text="Repositories" styleClass="stat-label"/>
          </VBox>
          <Region styleClass="v-divider"/>
          <VBox alignment="CENTER" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="stat-block">
            <Label id="statFollowers" text="0" styleClass="stat-number"/>
            <Label text="Followers" styleClass="stat-label"/>
          </VBox>
          <Region styleClass="v-divider"/>
          <VBox alignment="CENTER" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="stat-block">
            <Label id="statFollowing" text="0" styleClass="stat-number"/>
            <Label text="Following" styleClass="stat-label"/>
          </VBox>
          <Region styleClass="v-divider"/>
          <VBox alignment="CENTER" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="stat-block">
            <Label id="statStars" text="0" styleClass="stat-number"/>
            <Label text="Stars earned" styleClass="stat-label"/>
          </VBox>
        </HBox>
      </VBox>

